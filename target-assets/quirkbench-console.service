[Unit]
Description=Quirkbench offline recovery status and local network setup
After=local-fs.target
Conflicts=getty@tty2.service
Before=getty@tty2.service

[Service]
Type=simple
Environment=PYTHONPATH=/usr/lib/quirkbench
Environment=TERM=linux
ExecStart=/usr/bin/python3 -m quirkbench.console
StandardInput=tty-fail
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty2
TTYReset=yes
NoNewPrivileges=yes
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
