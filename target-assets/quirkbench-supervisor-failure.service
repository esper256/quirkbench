[Unit]
Description=Quirkbench preserve supervisor failure and request recovery
After=quirkbench-candidate.service quirkbench-recovery.service

[Service]
Type=oneshot
Environment=PYTHONPATH=/usr/lib/quirkbench
ExecStart=/usr/bin/python3 -m quirkbench.watchdog
TimeoutStartSec=20
StandardOutput=journal+console
StandardError=journal+console
Restart=no
