# Reviewed x86-64 UEFI/USB recovery overrides for a pinned Fedora config.
# Apply to the Fedora baseline, run olddefconfig, then audit the final config.
CONFIG_64BIT=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_MODULES=y
CONFIG_KALLSYMS=y
CONFIG_DMI_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_STORAGE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_EXT4_FS=y
CONFIG_EFI_PARTITION=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
# CONFIG_EFIVAR_FS is not set
# CONFIG_EFI_VARS is not set
# CONFIG_EFI_VARS_PSTORE is not set
# CONFIG_EFI_CAPSULE_LOADER is not set
# CONFIG_EFI_TEST is not set
# CONFIG_SCSI_LOWLEVEL is not set
# CONFIG_VIRTIO_PCI is not set
# CONFIG_VIRTIO_SCSI is not set
# CONFIG_SWAP is not set
# CONFIG_HIBERNATION is not set
# CONFIG_DEVMEM is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# Handover selects KEXEC_FILE in Fedora's patched kernel tree.
# CONFIG_KEXEC_HANDOVER is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_NVME_CORE is not set
# These transports/loopback select NVME_FABRICS, then NVME_CORE.
# CONFIG_NVME_RDMA is not set
# CONFIG_NVME_FC is not set
# CONFIG_NVME_TCP is not set
# CONFIG_NVME_TARGET_LOOP is not set
# CONFIG_ATA is not set
# CONFIG_VMD is not set
# CONFIG_MMC is not set
# CONFIG_VIRTIO_BLK is not set
