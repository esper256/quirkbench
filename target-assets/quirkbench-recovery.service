[Unit]
Description=Quirkbench recovery identity and data preparation
DefaultDependencies=no
After=local-fs.target var.mount tmp.mount
Requires=var.mount tmp.mount
Before=multi-user.target

[Service]
Type=oneshot
Environment=PYTHONPATH=/usr/lib/quirkbench
ExecStart=/usr/bin/python3 -m quirkbench.boot --config /etc/quirkbench/boot.json
RemainAfterExit=yes
TimeoutStartSec=900
StandardOutput=journal+console
StandardError=journal+console
NoNewPrivileges=yes
PrivateTmp=no

[Install]
WantedBy=multi-user.target
