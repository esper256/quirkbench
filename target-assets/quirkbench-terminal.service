[Unit]
Description=Quirkbench local root terminal
Conflicts=getty@tty3.service
Before=getty@tty3.service

[Service]
Type=simple
Environment=PYTHONPATH=/usr/lib/quirkbench
Environment=TERM=linux
ExecStart=/usr/bin/python3 -m quirkbench.local_terminal
StandardInput=tty-fail
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty3
TTYReset=yes
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
