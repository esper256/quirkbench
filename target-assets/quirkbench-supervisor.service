[Unit]
Description=Quirkbench experiment and recovery supervisor
After=quirkbench-candidate.service quirkbench-recovery.service network.target
OnFailure=quirkbench-supervisor-failure.service

[Service]
Type=notify
NotifyAccess=main
Environment=PYTHONPATH=/usr/lib/quirkbench
ExecStart=/usr/bin/python3 -m quirkbench.runtime
WatchdogSec=30
TimeoutStartSec=90
TimeoutStopSec=30
Restart=no
KillMode=control-group
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
