{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quirkbench.local/schemas/operation-result.v1.schema.json",
  "title": "Public operation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "public_artifacts", "private_deliverable"],
  "properties": {
    "schema_version": {"const": 1},
    "public_artifacts": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "private_deliverable": {"type": "null", "description": "Private descriptors remain disabled until a private store and restore availability check exist."}
  }
}
