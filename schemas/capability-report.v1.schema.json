{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quirkbench:schema:capability-report:v1",
  "title": "Capability report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["device_id", "boot_id", "capabilities"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1, "default": 1},
    "device_id": {"$ref": "#/$defs/identifier"},
    "boot_id": {"$ref": "#/$defs/identifier"},
    "capabilities": {"type": "array", "items": {"$ref": "#/$defs/identifier"}},
    "mode": {"type": "string", "enum": ["recovery", "experiment", "simulation"], "default": "recovery"},
    "inventory": {"type": "object", "default": {}}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"}
  }
}
