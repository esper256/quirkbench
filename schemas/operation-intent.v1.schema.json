{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quirkbench.local/schemas/operation-intent.v1.schema.json",
  "title": "Local durable operation intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "campaign_id",
    "device_id",
    "arguments",
    "input_refs",
    "source_refs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "$ref": "#/$defs/id"
    },
    "campaign_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/id"
        }
      ]
    },
    "device_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/id"
        }
      ]
    },
    "arguments": {
      "type": "object",
      "maxProperties": 256
    },
    "input_refs": {
      "$ref": "#/$defs/digests"
    },
    "source_refs": {
      "$ref": "#/$defs/digests"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "digests": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
