{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quirkbench recovery recipe v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "recipe_id", "baseline_id", "baseline_digest", "rootfs_lock_sha256", "kernel_srpm_sha256", "kernel_config_sha256", "recovery_fragment_sha256", "dracut_config_sha256", "builder_image_digest", "runtime_revision_sha256", "unit_allowlist_sha256", "source_date_epoch", "layout", "policy"],
  "properties": {
    "schema_version": {"const": 1},
    "recipe_id": {"$ref": "#/$defs/identifier"},
    "baseline_id": {"$ref": "#/$defs/identifier"},
    "baseline_digest": {"$ref": "#/$defs/sha256"},
    "rootfs_lock_sha256": {"$ref": "#/$defs/sha256"},
    "kernel_srpm_sha256": {"$ref": "#/$defs/sha256"},
    "kernel_config_sha256": {"$ref": "#/$defs/sha256"},
    "recovery_fragment_sha256": {"$ref": "#/$defs/sha256"},
    "dracut_config_sha256": {"$ref": "#/$defs/sha256"},
    "builder_image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "runtime_revision_sha256": {"$ref": "#/$defs/sha256"},
    "unit_allowlist_sha256": {"$ref": "#/$defs/sha256"},
    "source_date_epoch": {"type": "integer", "minimum": 0},
    "layout": {
      "type": "object", "additionalProperties": false,
      "required": ["factory_size_mib", "root_mib", "experiment_mib", "library_mib", "log_budget_mib"],
      "properties": {
        "factory_size_mib": {"type": "integer", "minimum": 1},
        "root_mib": {"type": "integer", "minimum": 1},
        "experiment_mib": {"type": "integer", "minimum": 1},
        "library_mib": {"type": "integer", "minimum": 1},
        "log_budget_mib": {"type": "integer", "minimum": 1}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["recovery_selinux", "secure_boot", "root_read_only", "firmware_writes", "internal_storage_access"],
      "properties": {
        "recovery_selinux": {"const": "disabled"},
        "secure_boot": {"const": "disabled"},
        "root_read_only": {"const": true},
        "firmware_writes": {"const": false},
        "internal_storage_access": {"const": false}
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
