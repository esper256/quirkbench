{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quirkbench:schema:checkpoint:v1",
  "title": "Checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["campaign_id"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1, "default": 1},
    "campaign_id": {"$ref": "#/$defs/identifier"},
    "artifacts": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "default": []},
    "notes": {"type": "object", "default": {}}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"}
  }
}
