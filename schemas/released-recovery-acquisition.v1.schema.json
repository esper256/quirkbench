{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Released recovery acquisition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "statement_sha256",
    "publisher_fingerprint",
    "assets",
    "qualified",
    "flash_authorized",
    "builder_ready",
    "baseline_ready"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "record_type": {
      "const": "released-recovery-acquisition"
    },
    "statement_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "publisher_fingerprint": {
      "type": "string",
      "pattern": "^([A-F0-9]{40}|[A-F0-9]{64})$"
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recovery_image",
        "recovery_manifest",
        "recovery_candidate",
        "release.json",
        "release.sig"
      ],
      "properties": {
        "recovery_image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1099511627776
            }
          }
        },
        "recovery_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1099511627776
            }
          }
        },
        "recovery_candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1099511627776
            }
          }
        },
        "release.json": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1099511627776
            }
          }
        },
        "release.sig": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1099511627776
            }
          }
        }
      }
    },
    "qualified": {
      "const": false
    },
    "flash_authorized": {
      "const": false
    },
    "builder_ready": {
      "const": false
    },
    "baseline_ready": {
      "const": false
    }
  }
}
