{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quirkbench recovery release candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "qualification_status", "qualified_capabilities",
    "recipe_digest", "baseline_id", "baseline_digest", "profile_digest", "architecture",
    "fedora_release", "builder_image_digest", "rootfs_lock_sha256", "rpm_snapshot_sha256",
    "target_rpm_lock_sha256", "toolchain_lock_sha256", "kernel_srpm_sha256",
    "source_tree_sha256", "recovery_fragment_sha256", "runtime_revision_sha256",
    "unit_allowlist_sha256", "dracut_config_sha256", "final_kernel_config_sha256",
    "module_files_digest", "kernel_release", "kernel_sha256", "initramfs_sha256",
    "image_sha256", "image_size_bytes", "image_manifest_sha256", "image_input_identity",
    "image_builder_identity", "rootfs_file_bytes", "rootfs_entry_count",
    "rootfs_required_bytes", "esp_payload_bytes", "esp_required_bytes",
    "layout", "policy"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "recovery-release-candidate"},
    "qualification_status": {"const": "unqualified"},
    "qualified_capabilities": {"const": []},
    "recipe_digest": {"$ref": "#/$defs/sha256"},
    "baseline_id": {"$ref": "#/$defs/identifier"},
    "baseline_digest": {"$ref": "#/$defs/sha256"},
    "profile_digest": {"$ref": "#/$defs/sha256"},
    "architecture": {"const": "x86_64"},
    "fedora_release": {"type": "string", "pattern": "^[0-9]{2}$"},
    "builder_image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "rootfs_lock_sha256": {"$ref": "#/$defs/sha256"},
    "rpm_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "target_rpm_lock_sha256": {"$ref": "#/$defs/sha256"},
    "toolchain_lock_sha256": {"$ref": "#/$defs/sha256"},
    "kernel_srpm_sha256": {"$ref": "#/$defs/sha256"},
    "source_tree_sha256": {"$ref": "#/$defs/sha256"},
    "recovery_fragment_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_revision_sha256": {"$ref": "#/$defs/sha256"},
    "unit_allowlist_sha256": {"$ref": "#/$defs/sha256"},
    "dracut_config_sha256": {"$ref": "#/$defs/sha256"},
    "final_kernel_config_sha256": {"$ref": "#/$defs/sha256"},
    "module_files_digest": {"$ref": "#/$defs/sha256"},
    "kernel_release": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"},
    "kernel_sha256": {"$ref": "#/$defs/sha256"},
    "initramfs_sha256": {"$ref": "#/$defs/sha256"},
    "image_sha256": {"$ref": "#/$defs/sha256"},
    "image_size_bytes": {"type": "integer", "minimum": 1},
    "image_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "image_input_identity": {"$ref": "#/$defs/sha256"},
    "image_builder_identity": {"$ref": "#/$defs/sha256"},
    "rootfs_file_bytes": {"type": "integer", "minimum": 0},
    "rootfs_entry_count": {"type": "integer", "minimum": 1},
    "rootfs_required_bytes": {"type": "integer", "minimum": 0},
    "esp_payload_bytes": {"type": "integer", "minimum": 0},
    "esp_required_bytes": {"type": "integer", "minimum": 0},
    "layout": {
      "type": "object", "additionalProperties": false,
      "required": ["factory_size_mib", "root_mib", "experiment_mib", "library_mib", "log_budget_mib"],
      "properties": {
        "factory_size_mib": {"type": "integer", "minimum": 1},
        "root_mib": {"type": "integer", "minimum": 1},
        "experiment_mib": {"type": "integer", "minimum": 1},
        "library_mib": {"type": "integer", "minimum": 1},
        "log_budget_mib": {"type": "integer", "minimum": 1}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["recovery_selinux", "secure_boot", "root_read_only", "firmware_writes", "internal_storage_access"],
      "properties": {
        "recovery_selinux": {"const": "disabled"},
        "secure_boot": {"const": "disabled"},
        "root_read_only": {"const": true},
        "firmware_writes": {"const": false},
        "internal_storage_access": {"const": false}
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
