{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authenticated retarget enrollment result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "request_id",
    "request_digest",
    "device_id",
    "media_instance_id",
    "target_binding",
    "controller_url",
    "credential_generation",
    "controller_ca_pem",
    "device_token",
    "repository_certificate_pem",
    "repository_remotes",
    "retarget_invitation"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "record_type": {
      "const": "enrollment-result"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "media_instance_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "target_binding": {
      "title": "Quirkbench TargetBinding v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "system_uuid"
      ],
      "properties": {
        "schema_version": {
          "const": 1,
          "type": "integer"
        },
        "system_uuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
          "not": {
            "enum": [
              "00000000-0000-0000-0000-000000000000",
              "ffffffff-ffff-ffff-ffff-ffffffffffff"
            ]
          }
        }
      }
    },
    "controller_url": {
      "type": "string",
      "pattern": "^https://[^/?#@]+:[0-9]+$",
      "maxLength": 4096
    },
    "credential_generation": {
      "title": "Credential generation v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "generation",
        "device_id",
        "media_instance_id",
        "system_uuid",
        "device_token_sha256",
        "repository_certificate_sha256",
        "expires_at"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "generation": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "media_instance_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "system_uuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
          "not": {
            "enum": [
              "00000000-0000-0000-0000-000000000000",
              "ffffffff-ffff-ffff-ffff-ffffffffffff"
            ]
          }
        },
        "device_token_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "repository_certificate_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expires_at": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4102444800
        }
      }
    },
    "controller_ca_pem": {
      "type": "string",
      "maxLength": 65536
    },
    "device_token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "repository_certificate_pem": {
      "type": "string",
      "maxLength": 65536
    },
    "repository_remotes": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "public_key"
        ],
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^https://[^/?#@]+:[0-9]+/[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "public_key": {
            "type": "string",
            "maxLength": 65536
          }
        }
      }
    },
    "retarget_invitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "code",
        "scope",
        "boot_authorized",
        "one_shot_cleared",
        "old_evidence_drained"
      ],
      "properties": {
        "schema_version": {
          "const": 1,
          "type": "integer"
        },
        "record_type": {
          "const": "retarget-invitation"
        },
        "code": {
          "title": "Public enrollment invitation metadata v1",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "record_type",
            "code_id",
            "request_id",
            "request_digest",
            "name",
            "controller_url",
            "certificate_sha256",
            "created_at",
            "expires_at"
          ],
          "properties": {
            "schema_version": {
              "type": "integer",
              "const": 1
            },
            "record_type": {
              "const": "enrollment-code"
            },
            "code_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
            },
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
            },
            "request_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "certificate_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "controller_url": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^https://[^/?#@]+:[0-9]+$"
            },
            "created_at": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4102444800
            },
            "expires_at": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4102444800
            }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "old_device_id",
            "old_generation",
            "old_generation_sha256",
            "media_instance_id",
            "old_target_binding",
            "new_target_binding"
          ],
          "properties": {
            "schema_version": {
              "const": 1,
              "type": "integer"
            },
            "old_device_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
            },
            "old_generation": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
            },
            "old_generation_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "media_instance_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
            },
            "old_target_binding": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema_version",
                "system_uuid"
              ],
              "properties": {
                "schema_version": {
                  "const": 1,
                  "type": "integer"
                },
                "system_uuid": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
                }
              }
            },
            "new_target_binding": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema_version",
                "system_uuid"
              ],
              "properties": {
                "schema_version": {
                  "const": 1,
                  "type": "integer"
                },
                "system_uuid": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
                }
              }
            }
          }
        },
        "boot_authorized": {
          "const": false
        },
        "one_shot_cleared": {
          "const": false
        },
        "old_evidence_drained": {
          "const": false
        }
      }
    }
  },
  "$id": "enrollment-result.v2.schema.json"
}
