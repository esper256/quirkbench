{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "const": {
    "schema_version": 1,
    "profile_id": "stock-x86_64-uefi-usb-v1",
    "architecture": "x86_64",
    "boot_method": "uefi",
    "boot_transport": "usb",
    "required_boot_drivers": [
      "xhci_hcd",
      "usb_storage",
      "sd_mod",
      "ext4",
      "vfat"
    ],
    "policy": {
      "policy_id": "recovery-boot-device-v1",
      "passive_kernel_metadata": true,
      "userspace_internal_block_access": false,
      "root_read_only": true,
      "automount": false,
      "swap_resume": false,
      "firmware_writes": false,
      "recovery_selinux": "disabled",
      "secure_boot": "disabled"
    }
  }
}
