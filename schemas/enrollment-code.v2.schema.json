{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quirkbench.local/schemas/enrollment-code.v2.schema.json",
  "title": "Public non-expiring enrollment invitation metadata v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "code_id",
    "request_id",
    "request_digest",
    "name",
    "controller_url",
    "certificate_sha256",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "record_type": {
      "const": "enrollment-code"
    },
    "code_id": {
      "$ref": "#/$defs/id"
    },
    "request_id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "$ref": "#/$defs/id"
    },
    "request_digest": {
      "$ref": "#/$defs/sha256"
    },
    "certificate_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "controller_url": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^https://[^/?#@]+:[0-9]+$"
    },
    "created_at": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4102444800
    },
    "expires_at": {
      "type": "null"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
