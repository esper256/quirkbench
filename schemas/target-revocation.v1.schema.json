{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Target revocation receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "request_id",
    "action",
    "target",
    "code_id",
    "device_id",
    "generation",
    "revoked",
    "created_at",
    "paused_campaigns_at_revoke",
    "unresolved_attempts_at_revoke",
    "workers_pending_at_revoke",
    "physical_shutdown_verified",
    "evidence_drain_authorized",
    "boot_authorized",
    "paused_campaign_count_at_revoke",
    "unresolved_attempt_count_at_revoke",
    "worker_count_at_revoke",
    "work_lists_truncated"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "record_type": {
      "const": "target-revocation"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "action": {
      "enum": [
        "revoke",
        "revoke-code"
      ]
    },
    "target": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "code_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "device_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "generation": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "revoked": {
      "const": true
    },
    "created_at": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4102444800
    },
    "paused_campaigns_at_revoke": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
      },
      "uniqueItems": true,
      "maxItems": 1000
    },
    "unresolved_attempts_at_revoke": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
      },
      "uniqueItems": true,
      "maxItems": 1000
    },
    "workers_pending_at_revoke": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
      },
      "uniqueItems": true,
      "maxItems": 1000
    },
    "physical_shutdown_verified": {
      "const": false
    },
    "evidence_drain_authorized": {
      "const": false
    },
    "boot_authorized": {
      "const": false
    },
    "paused_campaign_count_at_revoke": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "unresolved_attempt_count_at_revoke": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "worker_count_at_revoke": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "work_lists_truncated": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "revoke"
          }
        }
      },
      "then": {
        "properties": {
          "code_id": {
            "type": "null"
          },
          "device_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "generation": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          }
        }
      },
      "else": {
        "properties": {
          "code_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "device_id": {
            "type": "null"
          },
          "generation": {
            "type": "null"
          },
          "paused_campaigns_at_revoke": {
            "maxItems": 0
          },
          "unresolved_attempts_at_revoke": {
            "maxItems": 0
          },
          "workers_pending_at_revoke": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
