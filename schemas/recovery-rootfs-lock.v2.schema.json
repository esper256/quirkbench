{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "recovery-rootfs-lock v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "architecture",
    "builder_image_digest",
    "fedora_release",
    "kernel_release",
    "rpm_key_fingerprint",
    "rpm_key_sha256",
    "rpm_snapshot_sha256",
    "schema_version",
    "storage_policy_sha256",
    "target_rpm_lock_sha256"
  ],
  "properties": {
    "rpm_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema_version": {
      "const": 2
    },
    "kernel_release": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
    },
    "target_rpm_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "storage_policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rpm_key_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "builder_image_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rpm_key_fingerprint": {
      "type": "string",
      "pattern": "^(?:[0-9A-F]{40}|[0-9A-F]{64})$"
    },
    "architecture": {
      "const": "x86_64"
    },
    "fedora_release": {
      "type": "string",
      "pattern": "^[0-9]{2}$"
    }
  }
}
