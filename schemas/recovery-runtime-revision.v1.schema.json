{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quirkbench recovery runtime revision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "files": {
      "type": "array", "minItems": 1, "maxItems": 512,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^(quirkbench/[A-Za-z0-9_]+\\.py|quirkbench/recipes/[A-Za-z0-9._-]+\\.json|target-assets/[A-Za-z0-9._-]+\\.(service|mount))$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
