{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "recovery-recipe v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "builder_image_digest",
    "dracut_config_sha256",
    "layout",
    "policy",
    "recipe_id",
    "rootfs_lock_sha256",
    "runtime_revision_sha256",
    "schema_version",
    "source_date_epoch",
    "storage_policy_sha256",
    "unit_allowlist_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "source_date_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_mib",
        "factory_size_mib",
        "library_payload_bytes"
      ],
      "properties": {
        "root_mib": {
          "type": "integer",
          "minimum": 256
        },
        "factory_size_mib": {
          "type": "integer",
          "minimum": 1024
        },
        "library_payload_bytes": {
          "type": "integer",
          "const": 0
        }
      }
    },
    "dracut_config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "storage_policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime_revision_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "unit_allowlist_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recipe_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "rootfs_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "builder_image_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "policy": {
      "const": {
        "policy_id": "recovery-boot-device-v1",
        "passive_kernel_metadata": true,
        "userspace_internal_block_access": false,
        "root_read_only": true,
        "automount": false,
        "swap_resume": false,
        "firmware_writes": false,
        "recovery_selinux": "disabled",
        "secure_boot": "disabled"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
