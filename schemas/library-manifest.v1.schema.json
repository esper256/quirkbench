{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "architecture": {
      "type": "string"
    },
    "runtime_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 10000,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "size",
          "executable"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "executable": {
            "type": "boolean"
          }
        }
      }
    },
    "entrypoints": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "architecture",
    "runtime_requirements",
    "files",
    "entrypoints"
  ]
}
