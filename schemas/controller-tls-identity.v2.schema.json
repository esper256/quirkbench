{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "request_id",
    "host",
    "files",
    "previous_identity",
    "previous_identity_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "record_type": {
      "const": "controller-tls-identity"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "host": {
      "type": "string",
      "maxLength": 45
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ca.key",
        "ca.crt",
        "controller.key",
        "controller.crt"
      ],
      "properties": {
        "ca.key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ca.crt": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "controller.key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "controller.crt": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "previous_identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previous_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "setup",
            "endpoint"
          ]
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "required": [
        "kind",
        "request_id"
      ]
    }
  },
  "$id": "https://quirkbench.invalid/schemas/controller-tls-identity.v2.schema.json"
}
