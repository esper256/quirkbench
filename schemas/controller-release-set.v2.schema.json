{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Controller release set v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "controller_version",
    "architecture",
    "controller_api",
    "target_api",
    "requires_python",
    "qualification_status",
    "issued_at",
    "expires_at",
    "controller_archive_sha256",
    "recovery_image_sha256",
    "builder_archive_sha256",
    "baseline_catalog_sha256",
    "builder_config_digest",
    "builder_image_digest",
    "interfaces",
    "recovery_candidate_sha256",
    "recovery_manifest_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "record_type": {
      "type": "string",
      "const": "controller-release-set"
    },
    "controller_version": {
      "type": "string",
      "pattern": "^[0-9][A-Za-z0-9.+-]{0,63}$"
    },
    "architecture": {
      "type": "string",
      "const": "x86_64"
    },
    "controller_api": {
      "type": "integer",
      "const": 1
    },
    "target_api": {
      "type": "integer",
      "const": 1
    },
    "requires_python": {
      "type": "string",
      "const": ">=3.11"
    },
    "qualification_status": {
      "type": "string",
      "const": "unqualified"
    },
    "issued_at": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4102444800
    },
    "expires_at": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4102444800
    },
    "controller_archive_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recovery_image_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "builder_archive_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "baseline_catalog_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recovery_candidate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "builder_image_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "builder_config_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "recovery_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_layout",
        "recovery_config",
        "recovery_candidate",
        "baseline_catalog",
        "device_protocol",
        "target_binding"
      ],
      "properties": {
        "image_layout": {
          "type": "integer",
          "const": 2
        },
        "recovery_config": {
          "type": "integer",
          "const": 2
        },
        "recovery_candidate": {
          "type": "integer",
          "const": 2
        },
        "baseline_catalog": {
          "type": "integer",
          "const": 1
        },
        "device_protocol": {
          "type": "integer",
          "const": 1
        },
        "target_binding": {
          "type": "integer",
          "const": 1
        }
      }
    }
  }
}
