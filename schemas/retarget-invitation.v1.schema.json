{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quirkbench.invalid/schemas/retarget-invitation.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "code",
    "scope",
    "boot_authorized",
    "one_shot_cleared",
    "old_evidence_drained"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "record_type": {
      "const": "retarget-invitation"
    },
    "code": {
      "title": "Public enrollment invitation metadata v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "code_id",
        "request_id",
        "request_digest",
        "name",
        "controller_url",
        "certificate_sha256",
        "created_at",
        "expires_at"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "record_type": {
          "const": "enrollment-code"
        },
        "code_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "request_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "certificate_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "controller_url": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^https://[^/?#@]+:[0-9]+$"
        },
        "created_at": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4102444800
        },
        "expires_at": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4102444800
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "old_device_id",
        "old_generation",
        "old_generation_sha256",
        "media_instance_id",
        "old_target_binding",
        "new_target_binding"
      ],
      "properties": {
        "schema_version": {
          "const": 1,
          "type": "integer"
        },
        "old_device_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "old_generation": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "old_generation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media_instance_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "old_target_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "system_uuid"
          ],
          "properties": {
            "schema_version": {
              "const": 1,
              "type": "integer"
            },
            "system_uuid": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
            }
          }
        },
        "new_target_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "system_uuid"
          ],
          "properties": {
            "schema_version": {
              "const": 1,
              "type": "integer"
            },
            "system_uuid": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
            }
          }
        }
      }
    },
    "boot_authorized": {
      "const": false
    },
    "one_shot_cleared": {
      "const": false
    },
    "old_evidence_drained": {
      "const": false
    }
  }
}
