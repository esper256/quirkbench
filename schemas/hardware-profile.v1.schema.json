{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quirkbench:schema:hardware-profile:v1",
  "title": "Hardware profile v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "profile_id", "platform_adapter_id", "architectures", "boot_methods", "boot_transport", "required_boot_drivers", "compatibility_network_drivers", "optional_peripherals", "protection", "minimum_ram_kib"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "profile_id": {"$ref": "#/$defs/id"},
    "platform_adapter_id": {"const": "x86_64-uefi-usb-v1"},
    "architectures": {"const": ["x86_64"]},
    "boot_methods": {"const": ["uefi"]},
    "boot_transport": {"const": "usb"},
    "required_boot_drivers": {"$ref": "#/$defs/ids"},
    "compatibility_network_drivers": {"$ref": "#/$defs/ids"},
    "optional_peripherals": {"$ref": "#/$defs/ids"},
    "protection": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_id", "excluded_internal_controller_drivers", "allowed_write_bus", "automount", "firmware_writes"],
      "properties": {
        "policy_id": {"$ref": "#/$defs/id"},
        "excluded_internal_controller_drivers": {"$ref": "#/$defs/ids"},
        "allowed_write_bus": {"const": "usb"},
        "automount": {"const": false}, "firmware_writes": {"const": false}
      }
    },
    "minimum_ram_kib": {"type": "integer", "minimum": 1, "maximum": 1099511627776}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "ids": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  }
}
