{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quirkbench.local/schemas/operation-response.v1.schema.json",
  "title": "Local operation response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ok", "operation_id", "data", "error"],
  "properties": {
    "schema_version": {"const": 1},
    "ok": {"type": "boolean"},
    "operation_id": {"type": ["string", "null"]},
    "data": {"type": ["object", "null"]},
    "error": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false,
         "required": ["code", "message", "retryable"],
         "properties": {"code": {"type": "string"}, "message": {"type": "string", "maxLength": 512}, "retryable": {"type": "boolean"}}}
      ]
    }
  },
  "allOf": [
    {"if": {"properties": {"ok": {"const": true}}}, "then": {"properties": {"error": {"type": "null"}}}},
    {"if": {"properties": {"ok": {"const": false}}}, "then": {"properties": {"data": {"type": "null"}, "error": {"type": "object"}}}}
  ]
}
