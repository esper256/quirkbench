{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "target-endpoint-source.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "intent_sha256",
    "transition",
    "files",
    "enrollment_origin"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "record_type": {
      "const": "target-endpoint-source"
    },
    "intent_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transition": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://quirkbench.invalid/schemas/target-endpoint-transition.v1.schema.json",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_certificate_sha256",
        "controller_url",
        "destination_generation",
        "destination_runtime_sha256",
        "enrollment_request_sha256",
        "enrollment_result_sha256",
        "record_type",
        "remote_urls",
        "request_id",
        "schema_version",
        "source_generation",
        "source_runtime_sha256"
      ],
      "properties": {
        "approved_certificate_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "controller_url": {
          "type": "string",
          "maxLength": 4096
        },
        "destination_generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "destination_runtime_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "enrollment_request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "enrollment_result_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "record_type": {
          "const": "target-endpoint-transition"
        },
        "remote_urls": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 8,
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "source_generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_runtime_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "files": {
      "type": "object",
      "minProperties": 11,
      "maxProperties": 32,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "enrollment_origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retarget_request_id",
        "selection_sha256"
      ],
      "properties": {
        "retarget_request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "selection_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
