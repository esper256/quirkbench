{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Controller state selection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "state_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(/|~/)"
    }
  }
}
