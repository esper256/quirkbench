{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quirkbench:schema:result:v1",
  "title": "Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["attempt_id", "outcome", "summary"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1, "default": 1},
    "attempt_id": {"$ref": "#/$defs/identifier"},
    "outcome": {"type": "string", "enum": ["PASS", "FAIL", "INCONCLUSIVE", "INFRA_FAILURE", "NEEDS_HUMAN"]},
    "summary": {"type": "string", "pattern": "\\S"},
    "evidence": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "default": []},
    "measurements": {"type": "object", "default": {}},
    "limitations": {"type": "array", "items": {"type": "string"}, "default": []}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"}
  }
}
