{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quirkbench:progress:v1",
  "title": "Progress v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "activity_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "phase": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "unit": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "state": {
      "enum": [
        "ACTIVE",
        "WAITING",
        "COMPLETE",
        "FAILED"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "completed": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "total": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "expected_update_s": {
      "type": "integer",
      "minimum": 1,
      "maximum": 604800
    },
    "stall_after_s": {
      "type": "integer",
      "minimum": 1,
      "maximum": 604800
    },
    "timeout_s": {
      "type": "integer",
      "minimum": 1,
      "maximum": 604800
    }
  },
  "required": [
    "activity_id",
    "campaign_id",
    "phase",
    "state",
    "message",
    "sequence"
  ],
  "description": "Runtime additionally enforces completed <= total, immutable denominator/deadline, and monotonic producer sequences."
}
