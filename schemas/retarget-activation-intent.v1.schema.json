{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retarget activation intent v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "retarget-activation-intent"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "local_intent_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "new_files": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intent.json": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "request.json": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "key.pem": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "result.json": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "intent.json",
        "request.json",
        "key.pem",
        "result.json"
      ]
    },
    "bundle_files": {
      "type": "object",
      "minProperties": 5,
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "generation": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtime_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "blank_journal_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "new_device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "new_credential_generation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "request_id",
    "local_intent_sha256",
    "source_sha256",
    "new_files",
    "bundle_files",
    "generation",
    "runtime_sha256",
    "blank_journal_sha256",
    "new_device_id",
    "new_credential_generation"
  ]
}
