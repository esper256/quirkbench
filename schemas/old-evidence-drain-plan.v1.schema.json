{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact original evidence drain plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "device_id",
    "generation",
    "attempt_id",
    "boot_id",
    "media_instance_id",
    "target_binding",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "record_type": {
      "const": "old-evidence-drain-plan"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "generation": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "boot_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "media_instance_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "target_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "system_uuid"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "system_uuid": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stream",
          "sequence",
          "sha256",
          "size"
        ],
        "properties": {
          "stream": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 134217728
          }
        }
      }
    }
  }
}
