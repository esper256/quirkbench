{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent publisher trust bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_base_url",
    "publisher_fingerprint",
    "public_key_file",
    "public_key_sha256",
    "not_before",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "release_base_url": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^https://[^@?#]+/$"
    },
    "publisher_fingerprint": {
      "type": "string",
      "pattern": "^(?:[A-F0-9]{40}|[A-F0-9]{64})$"
    },
    "public_key_file": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}\\.asc$"
    },
    "public_key_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "not_before": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4102444800
    },
    "expires_at": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4102444800
    }
  }
}
