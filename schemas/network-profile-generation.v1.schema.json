{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quirkbench.local/schemas/network-profile-generation.v1.schema.json",
  "title": "Private selected network profile generation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "device_id",
    "media_instance_id",
    "target_binding",
    "runtime_sha256",
    "files"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "record_type": {
      "const": "network-profile-generation"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "media_instance_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "target_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "system_uuid"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "system_uuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        }
      }
    },
    "runtime_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": {
        "type": "string",
        "maxLength": 255,
        "pattern": "^[^./\\\\\\u0000-\\u001f][^/\\\\\\u0000-\\u001f]*\\.nmconnection$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
