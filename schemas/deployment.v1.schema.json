{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quirkbench deployment manifest v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "backend", "revision", "repository", "provenance", "protection_profile"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "backend": {"const": "ostree"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "provenance": {"type": "object", "minProperties": 1},
    "protection_profile": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"}
  }
}
