{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quirkbench.local/schemas/recipe-manifest.v2.schema.json",
  "title": "Installed reviewed recipe manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recipe_id",
    "version",
    "entrypoint",
    "code_sha256",
    "modes",
    "architectures",
    "required_capabilities",
    "required_privileges",
    "parameter_specs",
    "runtime_limit_s",
    "physical_observations",
    "risk_class"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "recipe_id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
    },
    "code_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "modes": {
      "$ref": "#/$defs/modes"
    },
    "architectures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "const": "x86_64"
      }
    },
    "required_capabilities": {
      "$ref": "#/$defs/ids"
    },
    "required_privileges": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "read_kernel_log",
          "audio_playback"
        ]
      }
    },
    "parameter_specs": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "minimum",
              "maximum"
            ],
            "properties": {
              "type": {
                "const": "integer"
              },
              "minimum": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "maximum": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "choices"
            ],
            "properties": {
              "type": {
                "const": "enum"
              },
              "choices": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                }
              }
            }
          }
        ]
      }
    },
    "runtime_limit_s": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "physical_observations": {
      "type": "array",
      "maxItems": 0
    },
    "risk_class": {
      "const": "observation"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "recovery",
          "experiment",
          "simulation"
        ]
      }
    }
  }
}
