{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 3
    },
    "unit": {
      "type": "string",
      "pattern": "^qb-worker-v2-[0-9a-f]{32}-[1-9][0-9]*$"
    },
    "engine": {
      "enum": [
        "docker",
        "podman"
      ]
    },
    "engine_identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "kind": {
          "const": "builder_prepare"
        },
        "stage": {
          "enum": [
            "builder_capture",
            "builder_import"
          ]
        },
        "worker_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "worker_generation": {
          "type": "integer",
          "minimum": 1
        },
        "worker_unit": {
          "type": "string",
          "pattern": "^qb-worker-v2-[0-9a-f]{32}-[1-9][0-9]*$"
        },
        "worker_boot_id": {
          "type": "string",
          "format": "uuid"
        },
        "stage_dir": {
          "type": "string",
          "pattern": "^/"
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "deadline": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "kind",
        "stage",
        "worker_epoch",
        "worker_generation",
        "worker_unit",
        "worker_boot_id",
        "stage_dir",
        "input_digest",
        "deadline"
      ]
    },
    "worker_image": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reserve_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1125899906842624
    },
    "payload_args": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recipe_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": []
    },
    "executions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^qb-[0-9a-f]{32}$"
          },
          "image": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "phase": {
            "enum": [
              "prepare",
              "build",
              "compose",
              "candidate",
              "recovery",
              "builder-marker",
              "distribution",
              "distribution-import"
            ]
          },
          "start_requested": {
            "type": "boolean"
          },
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "stopped": {
            "type": "boolean"
          },
          "removed": {
            "type": "boolean"
          },
          "log_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "name",
          "image",
          "phase",
          "start_requested"
        ]
      }
    },
    "phase": {
      "enum": [
        "reserved",
        "prepare",
        "build",
        "compose",
        "candidate",
        "recovery",
        "builder-marker",
        "distribution",
        "distribution-import"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "stopped": {
      "type": "boolean"
    },
    "monotonic_deadline": {
      "type": "number"
    },
    "bootstrap": {
      "const": true
    }
  },
  "required": [
    "schema_version",
    "unit",
    "engine",
    "engine_identity",
    "claim",
    "worker_image",
    "reserve_bytes",
    "payload_args",
    "executions",
    "phase",
    "complete",
    "monotonic_deadline",
    "bootstrap"
  ]
}
