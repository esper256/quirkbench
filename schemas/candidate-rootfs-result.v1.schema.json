{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quirkbench.invalid/schemas/candidate-rootfs-result.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "candidate_input_sha256", "builder_image_digest", "builder_config_digest", "builder_archive_sha256", "target_tree_sha256", "sysroot_archive_sha256"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "record_type": {"const": "candidate-rootfs-result"},
    "candidate_input_sha256": {"$ref": "#/$defs/digest"},
    "builder_image_digest": {"$ref": "#/$defs/image"},
    "builder_config_digest": {"$ref": "#/$defs/image"},
    "builder_archive_sha256": {"$ref": "#/$defs/digest"},
    "target_tree_sha256": {"$ref": "#/$defs/digest"},
    "sysroot_archive_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "image": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
