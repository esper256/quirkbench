{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quirkbench.invalid/schemas/proposal-experiment-input.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "base_capture_sha256",
    "base_oid",
    "baseline_sha256",
    "build_input_sha256",
    "composition_input_sha256",
    "composition_link_sha256",
    "composition_operation_id",
    "composition_output_sha256",
    "deployment_sha256",
    "dispatch_sha256",
    "experiment_id",
    "investigation_id",
    "proposal_operation_id",
    "proposal_sha256",
    "recipe_id",
    "recipe_manifest_sha256",
    "source_capture_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "record_type": {
      "const": "proposal-experiment-input"
    },
    "base_capture_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base_oid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "baseline_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "build_input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "composition_input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "composition_link_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "composition_operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "composition_output_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "deployment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dispatch_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "investigation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "proposal_operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "proposal_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recipe_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "recipe_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_capture_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
