{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "unit": {
      "type": "string",
      "pattern": "^qb-development-v2-quirkbench-build-[a-z0-9-]+$"
    },
    "engine": {
      "const": "podman"
    },
    "engine_identity": {
      "type": "string",
      "maxLength": 4096
    },
    "executions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^qb-development-[0-9a-f]{32}$"
          },
          "image": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "start_requested": {
            "type": "boolean"
          },
          "removed": {
            "type": "boolean"
          },
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "stopped": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "image",
          "start_requested",
          "removed"
        ]
      }
    },
    "complete": {
      "type": "boolean"
    },
    "stopped": {
      "type": "boolean"
    },
    "run_id": {
      "type": "string",
      "pattern": "^quirkbench-build-[a-z0-9-]+$",
      "maxLength": 128
    },
    "image": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "unit",
    "engine",
    "engine_identity",
    "executions",
    "complete",
    "stopped",
    "run_id",
    "image"
  ]
}
