{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quirkbench.invalid/schemas/retarget-local-intent.v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "request_id",
    "old_device_id",
    "media_instance_id",
    "old_target_binding",
    "new_target_binding",
    "runtime_sha256",
    "boot_config_sha256",
    "previous_selection_sha256",
    "endpoint_selection_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 3
    },
    "record_type": {
      "const": "retarget-local-intent"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "old_device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "media_instance_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "old_target_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "system_uuid"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "system_uuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        }
      }
    },
    "new_target_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "system_uuid"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "system_uuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        }
      }
    },
    "runtime_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "boot_config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previous_selection_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "endpoint_selection_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
