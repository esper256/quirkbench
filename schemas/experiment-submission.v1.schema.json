{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experiment submission input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hypothesis",
    "source",
    "recipe"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "baseline"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "quiesced"
          ],
          "properties": {
            "mode": {
              "const": "workspace"
            },
            "quiesced": {
              "type": "boolean",
              "const": true
            }
          }
        }
      ]
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parameters",
        "timeout_seconds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "parameters": {
          "type": "object"
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },
    "repository": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
