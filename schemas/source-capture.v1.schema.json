{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quirkbench.example/schemas/source-capture.v1.schema.json",
  "title": "Complete source capture v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "base_oid",
    "archive_sha256",
    "manifest_sha256",
    "file_count",
    "allowed_untracked",
    "provenance",
    "complete"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "source-capture"
    },
    "base_oid": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "archive_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 250000
    },
    "allowed_untracked": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_package_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "distribution_patches_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "upstream_base_oid": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        }
      }
    },
    "complete": {
      "const": true
    }
  }
}
