{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quirkbench.local/schemas/controller-service-capabilities.v1.schema.json",
  "title": "Current native service publication capability v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "enrollment_available",
    "repository_url",
    "configuration_sha256",
    "tls_identity_sha256",
    "not_before",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "enrollment_available": {
      "type": "boolean",
      "const": true
    },
    "repository_url": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^https://[^/?#@]+:[0-9]+$"
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tls_identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "not_before": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4102444800
    },
    "expires_at": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4102444800
    }
  }
}
