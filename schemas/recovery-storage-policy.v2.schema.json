{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "architecture",
    "boot_method",
    "boot_transport",
    "required_boot_drivers",
    "policy",
    "vendor_inventory_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "profile_id": {
      "const": "stock-x86_64-uefi-usb-v1"
    },
    "architecture": {
      "const": "x86_64"
    },
    "boot_method": {
      "const": "uefi"
    },
    "boot_transport": {
      "const": "usb"
    },
    "required_boot_drivers": {
      "const": [
        "xhci_hcd",
        "usb_storage",
        "sd_mod",
        "ext4",
        "vfat"
      ]
    },
    "policy": {
      "const": {
        "policy_id": "recovery-boot-device-v1",
        "passive_kernel_metadata": true,
        "userspace_internal_block_access": false,
        "root_read_only": true,
        "automount": false,
        "swap_resume": false,
        "firmware_writes": false,
        "recovery_selinux": "disabled",
        "secure_boot": "disabled"
      }
    },
    "vendor_inventory_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
