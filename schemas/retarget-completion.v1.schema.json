{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retarget completion v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "retarget-completion"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "activation_intent_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "activated": {
      "const": true
    },
    "boot_authorized": {
      "const": false
    },
    "reset_qualified": {
      "const": false
    },
    "old_evidence_drained": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "request_id",
    "activation_intent_sha256",
    "activated",
    "boot_authorized",
    "reset_qualified",
    "old_evidence_drained"
  ]
}
