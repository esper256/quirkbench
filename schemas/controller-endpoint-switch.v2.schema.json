{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quirkbench.invalid/schemas/controller-endpoint-switch.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "request_id",
    "source_configuration",
    "destination_configuration",
    "tls_intent_sha256",
    "source_identity_sha256",
    "destination_identity_sha256",
    "approved_certificate_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "record_type": {
      "const": "controller-endpoint-switch"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "source_configuration": {
      "type": "object"
    },
    "destination_configuration": {
      "type": "object"
    },
    "tls_intent_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "destination_identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "approved_certificate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
