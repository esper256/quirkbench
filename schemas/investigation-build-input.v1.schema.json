{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quirkbench:schema:investigation-build-input:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "investigation_id",
    "baseline_sha256",
    "source_capture_operation_id",
    "source_capture_sha256",
    "source_preparation_operation_id",
    "source_preparation_sha256",
    "source_workspace_sha256",
    "base_capture_sha256",
    "distribution_provenance_sha256",
    "candidate_operation_id",
    "candidate_result_sha256",
    "builder_image_digest",
    "builder_config_digest",
    "builder_archive_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "investigation-build-input"
    },
    "investigation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "baseline_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_capture_operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "source_capture_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_preparation_operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "source_preparation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_workspace_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base_capture_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "distribution_provenance_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "candidate_result_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "builder_image_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "builder_config_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "builder_archive_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
