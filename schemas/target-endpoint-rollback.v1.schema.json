{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "target-endpoint-rollback.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "request_id",
    "source_sha256",
    "intent_sha256",
    "restored_generation",
    "restored_runtime_sha256",
    "activation_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "record_type": {
      "const": "target-endpoint-rollback"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "intent_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "restored_generation": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "restored_runtime_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "activation_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    }
  }
}
