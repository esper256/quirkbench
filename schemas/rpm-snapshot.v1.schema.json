{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quirkbench retained RPM snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packages"],
  "properties": {
    "schema_version": {"const": 1},
    "packages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8192,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "nevra", "sha256"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9+_.-]{0,127}$"},
          "nevra": {"type": "string", "pattern": "^[A-Za-z0-9+_.-]+-[0-9]+:[A-Za-z0-9+_.~^-]+\\.(?:[A-Za-z0-9_]+|\\(none\\))$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
