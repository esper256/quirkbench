{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quirkbench.invalid/schemas/proposal-dispatch-input.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "action",
    "candidate_operation_id",
    "context_sha256",
    "investigation_id",
    "proposal_operation_id",
    "proposal_sha256",
    "repository",
    "signing_fingerprint"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "record_type": {
      "const": "proposal-dispatch-input"
    },
    "action": {
      "enum": [
        "experiment",
        "needs_human",
        "conclude"
      ]
    },
    "candidate_operation_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "investigation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "proposal_operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "proposal_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "signing_fingerprint": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:[0-9A-F]{40}|[0-9A-F]{64})$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "experiment"
          }
        }
      },
      "then": {
        "properties": {
          "candidate_operation_id": {
            "not": {
              "type": "null"
            }
          },
          "repository": {
            "not": {
              "type": "null"
            }
          },
          "signing_fingerprint": {
            "not": {
              "type": "null"
            }
          }
        }
      },
      "else": {
        "properties": {
          "candidate_operation_id": {
            "type": "null"
          },
          "repository": {
            "type": "null"
          },
          "signing_fingerprint": {
            "type": "null"
          }
        }
      }
    }
  ]
}
