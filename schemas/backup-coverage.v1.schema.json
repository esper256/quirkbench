{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "record_type": {
      "const": "backup-coverage"
    },
    "cut": {
      "type": "object",
      "properties": {
        "database_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "backup_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "database_user_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": [
        "database_sha256",
        "backup_manifest_sha256",
        "database_user_version"
      ],
      "additionalProperties": false
    },
    "contents": {
      "type": "object",
      "properties": {
        "controller_complete": {
          "const": true
        },
        "whole_session_complete": {
          "const": false
        },
        "captured_source_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "checkpoint_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "retained_artifact_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "retained_deployment_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "pending_upload_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "controller_complete",
        "whole_session_complete",
        "captured_source_count",
        "checkpoint_count",
        "retained_artifact_count",
        "retained_deployment_count",
        "pending_upload_count"
      ],
      "additionalProperties": false
    },
    "source_workspaces": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "campaign_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "writer_state": {
            "enum": [
              "EDITING",
              "QUIESCED",
              "PREPARING",
              "UNAVAILABLE"
            ]
          },
          "preparation_operation_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "scope_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "base_oid": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
              },
              {
                "type": "null"
              }
            ]
          },
          "capture_operation_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "capture_state": {
            "anyOf": [
              {
                "enum": [
                  "QUEUED",
                  "RUNNING",
                  "WAITING",
                  "SUCCEEDED",
                  "FAILED",
                  "INTERRUPTED"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "capture_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "captured_source_complete": {
            "type": "boolean"
          },
          "current_source_covered": {
            "type": "boolean"
          },
          "captured_dirty_state": {
            "enum": [
              "unknown",
              "modified",
              "unmodified"
            ]
          }
        },
        "required": [
          "workspace_id",
          "campaign_id",
          "writer_state",
          "preparation_operation_id",
          "scope_sha256",
          "base_oid",
          "capture_operation_id",
          "capture_state",
          "capture_sha256",
          "captured_source_complete",
          "current_source_covered",
          "captured_dirty_state"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "current_source_covered": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "captured_source_complete": {
                  "const": true
                },
                "writer_state": {
                  "const": "QUIESCED"
                },
                "capture_state": {
                  "const": "SUCCEEDED"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "captured_source_complete": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "capture_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "base_oid": {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                }
              }
            }
          }
        ]
      }
    },
    "active_operations": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "operation_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "kind": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "state": {
            "enum": [
              "QUEUED",
              "RUNNING",
              "WAITING",
              "INTERRUPTED"
            ]
          },
          "stage": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "operation_id",
          "kind",
          "state",
          "stage"
        ],
        "additionalProperties": false
      }
    },
    "targets": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "last_reported_mode": {
            "enum": [
              "recovery",
              "experiment",
              "simulation",
              "unknown"
            ]
          },
          "pending_return_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "unresolved_attempt_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "target_only_backlog": {
            "const": "unknown"
          }
        },
        "required": [
          "device_id",
          "last_reported_mode",
          "pending_return_count",
          "unresolved_attempt_count",
          "target_only_backlog"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "private-identity-files-omitted",
          "operator-configuration-omitted",
          "editable-workspaces-and-git-omitted",
          "target-only-evidence-unknown",
          "partial-upload-bytes-omitted",
          "workspace-capture-incomplete"
        ]
      }
    },
    "restore_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "private-identity",
          "operator-configuration",
          "editable-git-workspaces",
          "target-reconciliation",
          "explicit-resume"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "cut",
    "contents",
    "source_workspaces",
    "active_operations",
    "targets",
    "limitations",
    "restore_requirements"
  ],
  "additionalProperties": false
}
