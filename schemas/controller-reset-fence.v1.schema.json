{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Controller reset fence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "archive"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "archive": {
      "type": "string",
      "pattern": "^/.+"
    }
  }
}
