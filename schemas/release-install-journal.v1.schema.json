{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signed pre-state installation journal v1",
  "$defs": {
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "version",
        "request_id",
        "release_base_url",
        "trust_bundle_sha256"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9][A-Za-z0-9.+-]{0,63}$"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "release_base_url": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^https://"
        },
        "trust_bundle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "statement_sha256",
        "signature_sha256"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "statement_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signature_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "request_id",
        "installation"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "record_type": {
          "const": "signed-release-installation"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "installation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "version",
            "archive_sha256",
            "signed",
            "qualified",
            "request_id",
            "distribution_verification"
          ],
          "properties": {
            "schema_version": {
              "type": "integer",
              "const": 1
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9][A-Za-z0-9.+-]{0,63}$"
            },
            "archive_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "signed": {
              "const": false
            },
            "qualified": {
              "const": false
            },
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
            },
            "distribution_verification": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "statement",
                "statement_sha256",
                "publisher_fingerprint",
                "qualification_status",
                "controller_archive_authenticated",
                "other_release_assets_verified"
              ],
              "properties": {
                "statement": {
                  "oneOf": [
                    {
                      "$ref": "controller-release-set.v1.schema.json"
                    },
                    {
                      "$ref": "controller-release-set.v2.schema.json"
                    }
                  ]
                },
                "statement_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "publisher_fingerprint": {
                  "type": "string",
                  "pattern": "^([A-F0-9]{40}|[A-F0-9]{64})$"
                },
                "qualification_status": {
                  "const": "unqualified"
                },
                "controller_archive_authenticated": {
                  "const": true
                },
                "other_release_assets_verified": {
                  "const": false
                }
              }
            }
          }
        }
      }
    }
  }
}
