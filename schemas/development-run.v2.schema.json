{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "run_id": {
      "type": "string",
      "pattern": "^quirkbench-build-[a-z0-9-]+$",
      "maxLength": 128
    },
    "unit": {
      "type": "string",
      "pattern": "^qb-development-v2-quirkbench-build-[a-z0-9-]+$"
    },
    "boot_id": {
      "type": "string",
      "format": "uuid"
    },
    "started": {
      "type": "number"
    },
    "command_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "unit",
    "boot_id",
    "started",
    "command_sha256"
  ]
}
