{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recovery checksum statement v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "qualification_status", "image_name", "image_sha256", "image_size_bytes", "image_checksum_sha256", "image_manifest_sha256", "release_candidate_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "recovery-checksum-statement"},
    "qualification_status": {"const": "unqualified"},
    "image_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.img$"},
    "image_sha256": {"$ref": "#/$defs/sha256"},
    "image_size_bytes": {"type": "integer", "minimum": 1},
    "image_checksum_sha256": {"$ref": "#/$defs/sha256"},
    "image_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "release_candidate_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
