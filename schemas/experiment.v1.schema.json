{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quirkbench:schema:experiment:v1",
  "title": "Experiment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["experiment_id", "hypothesis", "recipe"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1, "default": 1},
    "experiment_id": {"$ref": "#/$defs/identifier"},
    "hypothesis": {"type": "string", "pattern": "\\S"},
    "recipe": {"$ref": "#/$defs/identifier"},
    "artifacts": {"type": "object", "propertyNames": {"$ref": "#/$defs/identifier"}, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "default": {}},
    "parameters": {"type": "object", "default": {}},
    "required_capabilities": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true, "default": []},
    "repetitions": {"type": "integer", "minimum": 1, "maximum": 10000, "default": 1},
    "timeout_s": {"type": "integer", "minimum": 1, "maximum": 604800, "default": 300},
    "baseline_id": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}], "default": null},
    "provenance": {"type": "object", "default": {}},
    "success_criteria": {"type": "string", "pattern": "\\S", "default": "Recipe reports the expected observations"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"}
  }
}
