{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quirkbench:schema:attended-baseline-input:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "base_capture_sha256",
    "base_oid",
    "baseline_sha256",
    "build_input_sha256",
    "composition_input_sha256",
    "composition_link_sha256",
    "composition_operation_id",
    "composition_output_sha256",
    "deployment_sha256",
    "experiment_id",
    "investigation_id",
    "recipe_id",
    "recipe_manifest_sha256",
    "record_type",
    "schema_version",
    "source_capture_sha256"
  ],
  "properties": {
    "composition_operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "investigation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "recipe_id": {
      "const": "system-observation"
    },
    "base_capture_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "baseline_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "build_input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "composition_input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "composition_link_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "composition_output_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "deployment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recipe_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_capture_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "record_type": {
      "const": "attended-baseline-input"
    },
    "base_oid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    }
  }
}
