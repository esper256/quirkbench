{
  "schema_version": 5,
  "cases": [
    {
      "argv": [
        "target",
        "add",
        "lab",
        "--request-id",
        "pair-1",
        "--ttl-seconds",
        "300",
        "--json"
      ],
      "expected": {
        "action": "add",
        "name": "lab",
        "request_id": "pair-1",
        "ttl_seconds": 300,
        "json": true
      }
    },
    {
      "argv": [
        "target",
        "show",
        "lab",
        "--json"
      ],
      "expected": {
        "action": "show",
        "name": "lab",
        "json": true
      }
    },
    {
      "argv": [
        "target",
        "--url",
        "https://192.0.2.1:8443",
        "--ca",
        "ca.pem",
        "--token-file",
        "token",
        "--report",
        "report",
        "--once"
      ],
      "expected": {
        "action": null,
        "url": "https://192.0.2.1:8443",
        "once": true
      }
    },
    {
      "argv": [
        "target",
        "show",
        "lab",
        "--status-version",
        "2",
        "--json"
      ],
      "expected": {
        "action": "show",
        "name": "lab",
        "status_version": 2,
        "json": true
      }
    },
    {
      "argv": [
        "target",
        "revoke",
        "lab",
        "--generation",
        "generation-1",
        "--request-id",
        "revoke-1",
        "--json"
      ],
      "expected": {
        "action": "revoke",
        "name": "lab",
        "generation": "generation-1",
        "request_id": "revoke-1",
        "json": true
      }
    },
    {
      "argv": [
        "target",
        "revoke-code",
        "code-1"
      ],
      "expected": {
        "action": "revoke-code",
        "name": "code-1",
        "request_id": null,
        "json": false
      }
    },
    {
      "argv": [
        "target",
        "drain-approve",
        "target",
        "--file",
        "plan.json",
        "--request-id",
        "approve-1",
        "--ttl-seconds",
        "900",
        "--json"
      ],
      "expected": {
        "command": "target",
        "action": "drain-approve",
        "name": "target",
        "file": "plan.json",
        "request_id": "approve-1",
        "ttl_seconds": 900,
        "json": true
      }
    },
    {
      "argv": [
        "target",
        "drain-revoke",
        "target",
        "--grant",
        "drain-example",
        "--json"
      ],
      "expected": {
        "command": "target",
        "action": "drain-revoke",
        "name": "target",
        "grant": "drain-example",
        "json": true
      }
    }
  ]
