{
  "schema_version": 6,
  "cases": [
    {
      "argv": [
        "target",
        "pair",
        "lab",
        "--request-id",
        "pair-1",
        "--ttl-seconds",
        "300",
        "--json"
      ],
      "expected": {
        "action": "add",
        "name": "lab",
        "request_id": "pair-1",
        "ttl_seconds": 300,
        "json": true
      }
    },
    {
      "argv": [
        "target",
        "show",
        "lab",
        "--json"
      ],
      "expected": {
        "action": "show",
        "name": "lab",
        "json": true,
        "status_version": 2
      }
    },
    {
      "argv": [
        "target",
        "show",
        "lab",
        "--json"
      ],
      "expected": {
        "action": "show",
        "name": "lab",
        "status_version": 2,
        "json": true
      }
    },
    {
      "argv": [
        "target",
        "access",
        "revoke",
        "lab",
        "--generation",
        "generation-1",
        "--request-id",
        "revoke-1",
        "--json"
      ],
      "expected": {
        "action": "revoke",
        "name": "lab",
        "generation": "generation-1",
        "request_id": "revoke-1",
        "json": true
      }
    },
    {
      "argv": [
        "target",
        "pairing",
        "cancel",
        "code-1"
      ],
      "expected": {
        "action": "revoke-code",
        "name": "code-1",
        "request_id": null,
        "json": false
      }
    },
    {
      "argv": [
        "target",
        "evidence",
        "approve",
        "target",
        "--file",
        "plan.json",
        "--request-id",
        "approve-1",
        "--ttl-seconds",
        "900",
        "--json"
      ],
      "expected": {
        "command": "target",
        "action": "drain-approve",
        "name": "target",
        "file": "plan.json",
        "request_id": "approve-1",
        "ttl_seconds": 900,
        "json": true
      }
    },
    {
      "argv": [
        "target",
        "evidence",
        "revoke",
        "target",
        "--grant",
        "drain-example",
        "--json"
      ],
      "expected": {
        "command": "target",
        "action": "drain-revoke",
        "name": "target",
        "grant": "drain-example",
        "json": true
      }
    },
    {
      "argv": [
        "target",
        "reassign",
        "old-target",
        "--generation",
        "old-generation",
        "--new-name",
        "new-target",
        "--new-uuid",
        "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb",
        "--request-id",
        "retarget-1",
        "--json"
      ],
      "expected": {
        "action": "retarget-code",
        "name": "old-target",
        "generation": "old-generation",
        "new_name": "new-target",
        "new_uuid": "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb",
        "request_id": "retarget-1",
        "json": true
      }
    }
  ]
}
