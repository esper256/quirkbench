      }
    },
    {
      "argv": [
        "target",
        "show",
        "lab",
        "--json"
      ],
      "expected": {
        "action": "show",
        "name": "lab",
        "status_version": 2,
        "json": true
      }
    },
    {
      "argv": [
        "target",
        "access",
        "revoke",
        "lab",
        "--generation",
        "generation-1",
        "--request-id",
        "revoke-1",
