#!/bin/sh
# Source-checkout entry point. No installation, downloads or state creation.
set -eu
root=$(dirname -- "$(readlink -f -- "$0")")
if ! command -v python3 >/dev/null 2>&1; then
    echo 'Quirkbench requires Python 3.11 or newer. Install python3 using your Linux package manager.' >&2
    exit 2
fi
exec python3 -c '
import pathlib, sys
if sys.version_info < (3, 11):
    sys.exit("Quirkbench requires Python 3.11 or newer; update python3 using your Linux package manager.")
sys.dont_write_bytecode = True
root = pathlib.Path(sys.argv.pop(1))
sys.path.insert(0, str(root / "src"))
from quirkbench.cli import main
sys.exit(main())
' "$root" "$@"
