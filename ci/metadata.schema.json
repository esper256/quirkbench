{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quirkbench software run identity and outcome v1",
  "type": "object",
  "required": ["schema_version", "suite", "tested_commit", "pr_head", "pr_base", "dirty", "workflow", "run_id", "run_attempt", "job", "python", "build", "platform", "dependencies", "umask", "command", "started_at", "finished_at", "duration_seconds", "outcome", "exit_code"],
  "properties": {
    "schema_version": {"const": 1},
    "suite": {"type": "string"},
    "tested_commit": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "pr_head": {"type": ["string", "null"]},
    "pr_base": {"type": ["string", "null"]},
    "dirty": {"type": "boolean"},
    "workflow": {"type": ["string", "null"]},
    "run_id": {"type": ["string", "null"]},
    "run_attempt": {"type": ["string", "null"]},
    "job": {"type": ["string", "null"]},
    "python": {"type": "string"},
    "build": {"type": "array", "items": {"type": "string"}},
    "platform": {"type": "string"},
    "dependencies": {"type": "object", "additionalProperties": {"type": "string"}},
    "umask": {"type": "string", "pattern": "^[0-7]{3}$"},
    "command": {"type": "array", "items": {"type": "string"}},
    "started_at": {"type": "string"},
    "finished_at": {"type": ["string", "null"]},
    "duration_seconds": {"type": ["number", "null"], "minimum": 0},
    "exit_code": {"type": ["integer", "null"]},
    "outcome": {"enum": ["incomplete", "passed", "failed", "timeout", "cancelled"]}
  }
}
