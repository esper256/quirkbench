#!/bin/sh
# Read-only diagnostics usable before recovery's filesystem is available.
printf '\nQuirkbench early boot report\n\nBoot options:\n'
cat /proc/cmdline
printf '\nMemory:\n'
head -n 5 /proc/meminfo
printf '\nDetected disks and partitions:\n'
cat /proc/partitions
printf '\nFilesystem identifiers:\n'
ls -l /dev/disk/by-uuid 2>/dev/null
printf '\nUSB4 / Thunderbolt connection state:\n'
for device in /sys/bus/thunderbolt/devices/*; do
    [ -d "$device" ] || continue
    printf '%s\n' "$device"
    for field in device_name authorized security iommu_dma_protection; do
        [ -r "$device/$field" ] || continue
        printf '  %s: ' "$field"
        cat "$device/$field"
    done
done
printf '\nRecent kernel messages:\n'
dmesg | tail -n 100
printf '\nFull boot log: /run/initramfs/rdsosreport.txt (when generated by dracut)\n'
