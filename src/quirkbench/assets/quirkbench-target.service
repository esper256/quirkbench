[Unit]
Description=Quirkbench outbound target connection
After=quirkbench-prepare.service NetworkManager.service
Requires=quirkbench-prepare.service
Wants=NetworkManager.service

[Service]
LimitMEMLOCK=infinity
User=root
Nice=-5
CPUSchedulingResetOnFork=yes
ExecStart=/usr/bin/quirkbench-target run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
